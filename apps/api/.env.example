# Local API defaults. Do not put secrets in this file.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=replace-with-local-database-user
NEO4J_PASSWORD=replace-with-local-database-password
NEO4J_DATABASE=isn-dev
# Generate ignored local auth keys with `npm run auth:keys`.
AUTH_PRIVATE_KEY_PATH=.local/auth/private.pem
AUTH_PUBLIC_KEY_PATH=.local/auth/public.pem
AUTH_CSRF_SECRET_PATH=.local/auth/csrf.secret
AUTH_KEY_ID=local-rsa-1
AUTH_ISSUER=http://127.0.0.1:3000
AUTH_AUDIENCE=intelligent-social-network-web
AUTH_WEB_ORIGIN=http://127.0.0.1:5173
# Run `npm run neo4j:provision-test` to create the restricted test identity and
# ignored apps/api/.env.test.local. Never copy test credentials into this file.
