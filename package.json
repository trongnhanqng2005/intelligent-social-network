{
  "name": "intelligent-social-network",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=@intelligent-social-network/api",
    "dev:web": "npm run dev --workspace=@intelligent-social-network/web",
    "build:api": "npm run build --workspace=@intelligent-social-network/api",
    "build:web": "npm run build --workspace=@intelligent-social-network/web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test:api": "npm run test --workspace=@intelligent-social-network/api",
    "test:api:e2e": "npm run test:e2e --workspace=@intelligent-social-network/api",
    "neo4j:provision-test": "node --env-file=apps/api/.env apps/api/scripts/provision-test-user.mjs",
    "auth:keys": "npm run auth:keys --workspace=@intelligent-social-network/api",
    "neo4j:migrate:dev": "npm run build:api && node --env-file=apps/api/.env apps/api/dist/neo4j/migrate.js apply",
    "neo4j:migrate:test": "npm run build:api && node --env-file=apps/api/.env.test.local apps/api/dist/neo4j/migrate.js apply",
    "neo4j:status:dev": "npm run build:api && node --env-file=apps/api/.env apps/api/dist/neo4j/migrate.js status",
    "neo4j:status:test": "npm run build:api && node --env-file=apps/api/.env.test.local apps/api/dist/neo4j/migrate.js status",
    "test:neo4j": "npm run build:api && node --env-file=apps/api/.env.test.local --test tests/integration/neo4j/*.test.mjs",
    "test:neo4j:profile-preflight": "node --env-file=apps/api/.env.test.local --test tests/integration/neo4j/profile-readiness.test.mjs",
    "test:web": "npm run test --workspace=@intelligent-social-network/web",
    "test:integration": "npm run build:api && node --test tests/integration/*.test.mjs",
    "test:root": "npm run test:integration && npm run test:e2e",
    "test:root:e2e": "npm run test:e2e",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:auth": "node --env-file=apps/api/.env.test.local ./node_modules/@playwright/test/cli.js test --config tests/e2e/auth.playwright.config.ts",
    "test:e2e:profile": "node --env-file=apps/api/.env.test.local ./node_modules/@playwright/test/cli.js test --config tests/e2e/profile.playwright.config.ts",
    "test:e2e:headed": "npm run test:e2e -- --headed",
    "test:e2e:ui": "npm run test:e2e -- --ui",
    "test:e2e:report": "playwright show-report .artifacts/playwright/report",
    "test": "npm run test --workspaces",
    "start:api": "npm run start:prod --workspace=@intelligent-social-network/api",
    "preview:web": "npm run preview --workspace=@intelligent-social-network/web"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0"
  }
}
